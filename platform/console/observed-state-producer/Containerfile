# syntax=docker/dockerfile:1.7

FROM --platform=${TARGETPLATFORM} python:3.13-alpine@sha256:540c7d91f98ff6880174c40e99067bf5941eb54d818a7a5e094d188b196a934d

ARG VCS_REF=unknown
LABEL org.opencontainers.image.source="https://github.com/openkubes/openkubes" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.title="OpenKubes observed-state producer"

RUN addgroup -S openkubes \
    && adduser -S -G openkubes -u 65532 openkubes \
    && rm -rf /usr/local/lib/python3.13/site-packages/* /usr/local/bin/pip*
WORKDIR /app
COPY app.py /app/app.py
USER 65532:65532
EXPOSE 8443
STOPSIGNAL SIGTERM
ENTRYPOINT ["python3", "/app/app.py"]
