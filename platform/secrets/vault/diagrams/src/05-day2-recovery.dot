digraph day2 {
  rankdir=LR; bgcolor="white"; fontname="DejaVu Sans"; labelloc="t";
  label="Day-2 — unattended recovery & restore rehearsal"; fontsize=15;
  node [shape=box style="rounded,filled" fontname="DejaVu Sans" fontsize=11 color="#5E4DB2" fillcolor="#EAE6FF" margin="0.18,0.10"];
  edge [fontname="DejaVu Sans" fontsize=9 color="#42526E"];

  R    [label="Full restart /\nnode reboot" fillcolor="#FFEBE6" color="#DE350B"];
  AU   [label="Transit auto-unseal\n(unattended)" fillcolor="#FFF0B3" color="#FF8B00"];
  OK   [label="voters 3/3 restored" fillcolor="#E3FCEF" color="#00875A"];
  SNAP [label="Raft snapshot\n(encrypted, off-host)"];
  RES  [label="Restore rehearsal\n(monthly, crit.11 / A10)" fillcolor="#DEEBFF" color="#0052CC"];
  FULL [label="Full unseal verified,\nnot just FSM install" fillcolor="#E3FCEF" color="#00875A"];
  TB   [label="Transit-Vault backup\n+ verified custody"];

  R -> AU -> OK;
  SNAP -> RES -> FULL;
  TB -> AU [style=dashed color="#FF8B00"];
}
