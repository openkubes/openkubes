digraph crossplane {
  rankdir=TB; bgcolor="white"; fontname="DejaVu Sans"; labelloc="t";
  label="Role of Crossplane — VaultInstance & VaultConfig reconciliation"; fontsize=15;
  node [shape=box style="rounded,filled" fontname="DejaVu Sans" fontsize=11 color="#5E4DB2" fillcolor="#EAE6FF" margin="0.18,0.10"];
  edge [fontname="DejaVu Sans" fontsize=9 color="#42526E"];

  REG [label="ADR-013 cluster registration" fillcolor="#DEEBFF" color="#0052CC"];
  VC  [label="VaultConfig XR\n(per consumer cluster)"];
  VI  [label="VaultInstance XR\nok-shared-vault (singleton)" fillcolor="#FFF0B3" color="#FF8B00"];
  PV  [label="Crossplane provider-vault\n(ok-mgmt)"];
  VSRV[label="Vault server\nHA Raft 3/3 on ok-shared" fillcolor="#E3FCEF" color="#00875A"];
  ADM [label="Admission policy (crit.14)" fillcolor="#FFEBE6" color="#DE350B"];

  REG -> VC;
  VC  -> PV;
  VI  -> VSRV;
  PV  -> VSRV [label="auth/kubernetes/CLUSTER\nmount + config"];
  PV  -> VSRV [label="AuthBackendRole\nbound to workload SA"];
  PV  -> VSRV [label="okvc-CLUSTER-ROLE\nleast-privilege policy"];
  ADM -> VI   [label="rejects 2nd\nproduction VaultInstance" style=dashed color="#DE350B" dir=back];
}
