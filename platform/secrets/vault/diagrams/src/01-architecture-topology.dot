digraph topology {
  rankdir=LR; bgcolor="white"; compound=true; fontname="DejaVu Sans"; labelloc="t";
  label="OpenKubes Vault + VSO — Datacenter Topology (Path A)"; fontsize=15;
  node  [shape=box style="rounded,filled" fontname="DejaVu Sans" fontsize=11 color="#5E4DB2" fillcolor="#EAE6FF" margin="0.18,0.10"];
  edge  [fontname="DejaVu Sans" fontsize=9 color="#42526E"];

  subgraph cluster_mgmt {
    label="ok-mgmt  (Talos, 1 CP + 2 Worker)"; style="rounded,filled"; fillcolor="#F4F5F7"; color="#8993A4"; fontsize=12;
    XP [label="Crossplane control plane\n/ provider-vault"];
    TV [label="Transit Vault\n192.168.100.208:8200\n(auto-unseal origin)" fillcolor="#FFF0B3" color="#FF8B00"];
  }

  subgraph cluster_shared {
    label="ok-shared  (Talos)"; style="rounded,filled"; fillcolor="#F4F5F7"; color="#8993A4"; fontsize=12;
    LB [label="host LoadBalancer\n192.168.100.207:443 (MetalLB)"];
    TR [label="Traefik IngressRouteTCP\nTLS passthrough / SNI"];
    VA [label="vault-active\n(leader-only service)" fillcolor="#E3FCEF" color="#00875A"];
    subgraph cluster_raft {
      label="Vault HA — Integrated Storage (Raft) 3/3"; style="rounded,filled"; fillcolor="#DEEBFF"; color="#0052CC"; fontsize=11;
      V0 [label="vault-0"]; V1 [label="vault-1"]; V2 [label="vault-2"];
      V0 -> V1 [dir=both style=dotted color="#0052CC" constraint=false];
      V1 -> V2 [dir=both style=dotted color="#0052CC" constraint=false];
    }
  }

  subgraph cluster_consumer {
    label="ok-robotics  (consumer, Category A)"; style="rounded,filled"; fillcolor="#F4F5F7"; color="#8993A4"; fontsize=12;
    VSO [label="Vault Secrets Operator"];
    SEC [label="K8s Secret\nok-observability-credentials" fillcolor="#E3FCEF" color="#00875A"];
    APP [label="Observability stack\n(Grafana / OpenSearch)"];
  }

  XP  -> VA [label="reconciles auth mounts,\nroles, policies" lhead=cluster_shared];
  TV  -> V0 [label="Transit unseal key" style=dashed color="#FF8B00" lhead=cluster_raft];
  VSO -> LB [label="vault.ok-shared.internal"];
  LB  -> TR -> VA;
  VA  -> V0 [label="leads" lhead=cluster_raft];
  VSO -> SEC -> APP;
}
