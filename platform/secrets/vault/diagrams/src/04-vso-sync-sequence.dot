digraph vso {
  rankdir=TB; bgcolor="white"; fontname="DejaVu Sans"; labelloc="t";
  label="VSO secret-sync loop (VaultConnection → VaultAuth → VaultStaticSecret)"; fontsize=15;
  node [shape=box style="rounded,filled" fontname="DejaVu Sans" fontsize=11 margin="0.18,0.10"];
  edge [fontname="DejaVu Sans" fontsize=10 color="#42526E"];

  n1 [label="① VSO → Vault:  VaultConnection\n(192.168.100.207:443, SNI, CA)" fillcolor="#EAE6FF" color="#5E4DB2"];
  n2 [label="② VSO → Vault:  VaultAuth\n(mount kubernetes/CLUSTER, role sa-obs)" fillcolor="#EAE6FF" color="#5E4DB2"];
  n3 [label="③ Vault → VSO:  per-cluster auth token" fillcolor="#E3FCEF" color="#00875A"];
  n4 [label="④ VSO → Vault:  read KV secret/CLUSTER/app/…" fillcolor="#EAE6FF" color="#5E4DB2"];
  n5 [label="⑤ Vault → VSO:  secret data" fillcolor="#E3FCEF" color="#00875A"];
  n6 [label="⑥ VSO → App namespace:  materialise native\nK8s Secret (refreshAfter 60s)" fillcolor="#DEEBFF" color="#0052CC"];

  n1 -> n2 -> n3 -> n4 -> n5 -> n6;
}
