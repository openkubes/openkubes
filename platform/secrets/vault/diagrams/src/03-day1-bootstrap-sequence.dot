digraph day1 {
  rankdir=TB; bgcolor="white"; fontname="DejaVu Sans"; labelloc="t";
  label="Day-1 — install / bootstrap sequence"; fontsize=15;
  node [shape=box style="rounded,filled" fontname="DejaVu Sans" fontsize=11 color="#5E4DB2" fillcolor="#EAE6FF" margin="0.20,0.12"];
  edge [color="#42526E"];

  A [label="1. Deploy Vault HA (Raft 3/3) via VaultInstance XR"];
