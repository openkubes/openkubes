{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSourceBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::ok-db-backups"
    },
    {
      "Sid": "ListOnlyTheSourceClusterPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::ok-db-backups"
    },
    {
      "Sid": "ReadOnlyTheSourceClusterObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::ok-db-backups/${aws:username}/*"
    }
  ]
}
