{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDrillBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::ok-db-drill"
    },
    {
      "Sid": "ListOnlyTheDrillRunPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::ok-db-drill"
    },
    {
      "Sid": "ReadWriteOnlyTheDrillRunObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::ok-db-drill/${aws:username}/*"
    }
  ]
}
