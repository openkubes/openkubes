# OK-202 experimental distroless comparison only. Not the release Dockerfile.
# Python 3.13 runtime matches distroless python3-debian13 (Debian trixie).
# Both base tags MUST be digest-pinned after evaluation; revalidate lock for 3.13.\n# Packages installed with --target avoid copying a builder-linked Python interpreter.
FROM python:3.13-slim-trixie AS build
ENV PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY requirements-mcp.lock /tmp/requirements-mcp.lock
RUN python -m pip install --no-cache-dir --target /opt/python -r /tmp/requirements-mcp.lock

FROM gcr.io/distroless/python3-debian13:nonroot
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    OPENKUBES_MCP_TRANSPORT=streamable-http \
    OPENKUBES_MCP_HOST=0.0.0.0 \
    OPENKUBES_MCP_PORT=8000 \
    OPENKUBES_DOCS_INDEX=/data/index.json
COPY --from=build /opt/python /opt/python
ENV PYTHONPATH=/opt/python
WORKDIR /app
COPY indexer.py docs_mcp.py /app/
USER 10001:10001
EXPOSE 8000
ENTRYPOINT ["/usr/bin/python3", "/app/docs_mcp.py"]
