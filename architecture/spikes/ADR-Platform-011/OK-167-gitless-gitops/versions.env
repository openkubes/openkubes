# OK-167 — version pins for the gitless GitOps spike.
#
# This is the ONLY place where versions and digests are maintained (BRIEF B6).
# The Makefile does `include versions.env` + `export`, so every target and every
# script sees these values.
#
# Every digest below was resolved and verified on 2026-10-29; see evidence/00-preflight.md.
# Every image was confirmed to publish a linux/arm64 variant (the host is Apple Silicon).
#
# Rule: a container image is referenced by digest, never by tag alone (ADR-028 §4.3).
# Where a Helm chart sets the image itself, the values override it to tag@sha256:...

# ---------------------------------------------------------------------------
# Cluster
# ---------------------------------------------------------------------------
CLUSTER_NAME=ok167
CLUSTER_CONTEXT=kind-ok167

# kind v0.33.0 ships kindest/node:v1.37.0 by default. We deliberately pin a
# v1.36.x image instead: Argo CD 3.5 is tested only against Kubernetes v1.33-v1.36.
# Image and digest taken from the kind v0.33.0 release notes.
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
KUBERNETES_VERSION=v1.36.4

# NodePort that reaches zot from the host. Host port 5000 is unusable on macOS:
# the AirPlay Receiver (ControlCenter) listens there.
ZOT_NODEPORT=30500
ZOT_HOST=localhost:30500

# ---------------------------------------------------------------------------
# zot registry — identical pins to the registry-default profile where possible
# (platform/registry/zot/values-ok-shared.yaml)
# ---------------------------------------------------------------------------
ZOT_CHART_REPO=https://zotregistry.dev/helm-charts
ZOT_CHART_NAME=zot
ZOT_CHART_VERSION=0.1.122
ZOT_IMAGE_REPOSITORY=ghcr.io/project-zot/zot
# The tag v2.1.20 was verified to resolve to exactly this digest.
ZOT_IMAGE_TAG=v2.1.20@sha256:542e25be4d32e7879c0cfad93492a93c81b1e059cbd2d30d485d4bd567318234
ZOT_NAMESPACE=zot
ZOT_RELEASE=zot
# Release name must be `zot` so the service is zot.zot.svc.cluster.local.
ZOT_SERVICE_HOST=zot.zot.svc.cluster.local
ZOT_SERVICE_PORT=5000

# ---------------------------------------------------------------------------
# Argo CD
# ---------------------------------------------------------------------------
ARGOCD_CHART_REPO=https://argoproj.github.io/argo-helm
ARGOCD_CHART_NAME=argo-cd
ARGOCD_CHART_VERSION=10.11.6
# Chart 10.11.6 has appVersion v3.5.6 (verified). v3.6.0 exists only as an RC and is out of scope.
ARGOCD_VERSION=v3.5.6
ARGOCD_IMAGE_REPOSITORY=quay.io/argoproj/argocd
ARGOCD_IMAGE_TAG=v3.5.6@sha256:8e5cc5bb008df8a09dba439462e58c94c55b7735888d3ebde0c25fc05e4e5335
ARGOCD_NAMESPACE=argocd
ARGOCD_RELEASE=argocd
ARGOCD_PROJECT=ok167

# Chart defaults, set explicitly so the latency measurements state what they measured.
ARGOCD_RECONCILIATION_TIMEOUT=120s
ARGOCD_RECONCILIATION_JITTER=60s

# ---------------------------------------------------------------------------
# Repository layout in zot
# ---------------------------------------------------------------------------
# Machine prefix mirrors registry-default's `openkubes/machine/**`.
REPO_PREFIX=openkubes/machine/gitops
REPO_MANIFESTS=openkubes/machine/gitops/podinfo-manifests
REPO_KUSTOMIZE=openkubes/machine/gitops/podinfo-kustomize
REPO_CHARTS=openkubes/machine/gitops/charts
REPO_NEGATIVE_PREFIX=openkubes/machine/gitops/negative
REPO_IMPORTED=openkubes/machine/gitops/imported/podinfo-manifests

# Machine identities (ADR-028 §4.5 requires distinct, least-scope credentials).
# Passwords are generated into .local/credentials.env and never appear here.
IDENTITY_PUBLISHER=gitops-publisher
IDENTITY_PULLER=gitops-puller
IDENTITY_ADMIN=ok167-admin

# ---------------------------------------------------------------------------
# Demo workload
# ---------------------------------------------------------------------------
PODINFO_IMAGE_REPOSITORY=ghcr.io/stefanprodan/podinfo
PODINFO_VERSION_A=6.16.0
PODINFO_DIGEST_A=sha256:2c88592f2b8f51a9428c8039486fc41abac53c95dbbb884d03bebee0876a6d4d
PODINFO_VERSION_B=6.17.0
PODINFO_DIGEST_B=sha256:fa2f27c1a8561097e5144bfc0853eba6054d743b68b03de4cad4675616ddefb0
PODINFO_CHART_REF=oci://ghcr.io/stefanprodan/charts/podinfo
PODINFO_CHART_VERSION=6.17.0

# ---------------------------------------------------------------------------
# Supporting images — pinned by digest, all verified multi-arch with linux/arm64
# ---------------------------------------------------------------------------
# Chosen because it logs request headers AND body, which Q3.b needs to capture a
# CloudEvent in full.
EVENT_RECEIVER_IMAGE=mendhak/http-https-echo:37@sha256:f55000d9196bd3c853d384af7315f509d21ffb85de315c26e9874033b9f83e15
EVENTS_NAMESPACE=ok167-events

# Short-lived pod for `make probe-version`.
CURL_IMAGE=curlimages/curl:8.18.0@sha256:d94d07ba9e7d6de898b6d96c1a072f6f8266c687af78a74f380087a0addf5d17

# ---------------------------------------------------------------------------
# Namespaces
# ---------------------------------------------------------------------------
NS_DEMO=ok167-demo
NS_DIGEST=ok167-digest
NS_SEMVER=ok167-semver
NS_KUSTOMIZE=ok167-kustomize
NS_HELM=ok167-helm
NS_NEG=ok167-neg
NS_IMPORTED=ok167-imported

# ---------------------------------------------------------------------------
# Host toolchain versions, recorded at preflight (evidence/00-preflight.md)
# ---------------------------------------------------------------------------
# These are expectations the preflight asserts, not things it installs.
EXPECT_ORAS_VERSION=1.3.6
EXPECT_COSIGN_VERSION=3.1.4
EXPECT_GTAR_VERSION=1.35
EXPECT_HELM_MAJOR=4
EXPECT_KUBECTL_MINOR=37
