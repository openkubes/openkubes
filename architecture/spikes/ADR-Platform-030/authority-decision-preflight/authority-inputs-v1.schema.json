{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "evidence.openkubes.io/v1alpha1"},
    "kind": {"const": "AuthorityDecisionInputs"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ticket"],
      "properties": {
        "name": {"const": "ok141-authority-inputs-v1"},
        "ticket": {"const": "OK-141"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "state", "recordedAt", "sourcePackage", "authorityPrincipal", "governanceException", "gitOpsPlacementBoundary", "unresolvedInputs", "authorization", "summary", "rules"],
      "properties": {
        "version": {"const": "ok141-authority-inputs/v1"},
        "state": {"const": "RECORDED-PARTIAL-INPUTS-NO-GO"},
        "recordedAt": {"type": "string", "minLength": 20},
        "sourcePackage": {"type": "object"},
        "authorityPrincipal": {"type": "object"},
        "governanceException": {"type": "object"},
        "gitOpsPlacementBoundary": {"type": "object"},
        "unresolvedInputs": {"type": "object"},
        "authorization": {"type": "object"},
        "summary": {"type": "object"},
        "rules": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
