{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "evidence.openkubes.io/v1alpha1"},
    "kind": {"const": "GHCROfflinePublisherPrototype"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ticket"],
      "properties": {
        "name": {"const": "ok141-ghcr-publisher-offline-prototype-v1"},
        "ticket": {"const": "OK-141"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "state", "sourceObserverPrototype", "components", "supplyChain", "workflowContract", "publicationContract", "proof", "remainingBlockers", "authorization", "summary", "rules"],
      "properties": {
        "version": {"const": "ok141-ghcr-publisher-offline-prototype/v1"},
        "state": {"const": "IMPLEMENTED-OFFLINE-INERT-WRITE-CAPABLE-NOT-DEPLOYED-NO-GO"},
        "sourceObserverPrototype": {"type": "object"},
        "components": {"type": "object"},
        "supplyChain": {"type": "object"},
        "workflowContract": {"type": "object"},
        "publicationContract": {"type": "object"},
        "proof": {"type": "object"},
        "remainingBlockers": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string", "minLength": 1}},
        "authorization": {"type": "object"},
        "summary": {"type": "object"},
        "rules": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
